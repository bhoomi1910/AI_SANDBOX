# ─── AI-Powered Intelligent Sandbox · Frontend Environment ───────────────────
# The frontend talks to the FastAPI backend (backend/ dir). Start it with:
#     cd backend && uvicorn app.main:app --reload --port 8000
# then run `npm run dev` here. Requests go through the Vite /api proxy.
#
# Set VITE_USE_BACKEND=false only to force the built-in demo (mock) dataset.

VITE_USE_BACKEND=true
VITE_API_BASE_URL=/api
VITE_APP_NAME="AI-Powered Intelligent Sandbox"
