# AI-Powered Intelligent Sandbox · Frontend Environment
# Copy this file to .env and adjust values for your environment.

# Set to "false" to force the built-in demo (mock) dataset.
VITE_USE_BACKEND=true

# Backend API URL. Use "/api" when proxied through Vite or nginx.
VITE_API_BASE_URL=/api

# Application name (display only)
VITE_APP_NAME="AI-Powered Intelligent Sandbox"
