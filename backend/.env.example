# ─── Aegis Sandbox AI · Backend Environment ────────────────────────────────
ENVIRONMENT=development

# Database — SQLite by default (no setup). Swap for PostgreSQL in production:
# DATABASE_URL=postgresql+psycopg2://aegis:aegis@localhost:5432/aegis
DATABASE_URL=sqlite:///./aegis.db

# Redis / Celery (optional — production task queue)
REDIS_URL=redis://localhost:6379/0

# AI — leave USE_REAL_LLM=false to use the built-in deterministic simulator.
USE_REAL_LLM=false
AI_MODEL=aegis-analyst-v2
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Threat intelligence API keys (optional — mock data used when blank)
VIRUSTOTAL_API_KEY=
OTX_API_KEY=
ABUSEIPDB_API_KEY=

# CORS (frontend dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
