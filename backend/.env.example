# AI-Powered Intelligent Sandbox · Backend Environment
# Copy this file to .env and adjust values for your environment.
# All values are optional — defaults in config.py are safe for local development.

# Environment: development | test | production
ENVIRONMENT=development

# Database — SQLite by default (no setup required).
# For production, use PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/dbname
DATABASE_URL=sqlite:///./aegis.db

# Optional infrastructure (not used by the demo)
# REDIS_URL=redis://localhost:6379/0

# AI — local Ollama ONLY. No cloud/paid inference.
# Leave AI_MODEL empty to auto-discover the first installed free model.
OLLAMA_URL=http://localhost:11434
AI_MODEL=
AI_TIMEOUT_SECONDS=120
AI_PROBE_TIMEOUT_SECONDS=3

# File handling
MAX_UPLOAD_SIZE=104857600          # 100 MiB
# UPLOAD_DIR=../uploads
# REPORT_DIR=../reports

# CORS — comma-separated list of allowed origins.
# In production, set to your actual frontend URL(s).
# Do NOT use * in production with credentials.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
