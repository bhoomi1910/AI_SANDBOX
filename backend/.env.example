# AI-Powered Intelligent Sandbox · Backend Environment
# (Settings are read from backend/app/config.py; every value here is optional —
#  the defaults are safe for a zero-setup local run.)

# Environment: development / test / production
ENVIRONMENT=development

# Database — SQLite by default (no setup). Swap for PostgreSQL in production:
# DATABASE_URL=postgresql+psycopg2://aegis:aegis@localhost:5432/aegis
DATABASE_URL=sqlite:///./aegis.db

# Optional infrastructure (production task queue — not used by the demo)
REDIS_URL=redis://localhost:6379/0

# AI (Phase 4) — local Ollama ONLY. No cloud/paid inference.
# Leave AI_MODEL empty to auto-discover the first installed free model via
# Ollama's /api/tags. Analysis never depends on the AI.
OLLAMA_URL=http://localhost:11434
AI_MODEL=
AI_TIMEOUT_SECONDS=120
AI_PROBE_TIMEOUT_SECONDS=3

# File handling
MAX_UPLOAD_SIZE=104857600          # 100 MiB
# UPLOAD_DIR=../uploads            # optional override
# REPORT_DIR=../reports            # optional override

# CORS (frontend dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
